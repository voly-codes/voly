    {
      "id": "claim_f2dd1a431cf3481298be4317a17fc677",
      "statement": "`Pipeline.run()` treats explicit A2A protocol delegation and automatic multi-agent dispatch as separate paths: explicit delegation creates and delegates one A2A task before routing and returns early only for completed or working tasks, while automatic dispatch occurs after route analysis only when it is enabled, not nested, eligible by capability flags or high complexity, and decomposition produces at least two subtasks.",
      "evidence": [
        {
          "resource": "repo://voly/pipeline/core.py#L417-L442",
          "version": "repo-lines-v1:sha256:52e7a47f1dab1a72a3e9918b35294c7afcd14b7d8d487c7ec96e9714beb0d373:"
